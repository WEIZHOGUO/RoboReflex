<mujoco model="paddle_catch">
  <!-- 机映 RoboReflex M1：平面挡板接球场景
       物理步进 500Hz（timestep=0.002），挡板 1 自由度沿 x 滑动，
       小球为自由刚体，reset 后由环境钉在发球点、到设定时刻释放。 -->
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8"/>
  </visual>

  <worldbody>
    <light pos="0 -2 4" dir="0 0.5 -1" diffuse="0.9 0.9 0.9"/>
    <!-- 侧视相机：沿 -y 看 x-z 平面，挡板横移动作在画面内左右可见 -->
    <camera name="side" pos="0 -3.5 0.9" xyaxes="1 0 0 0 0 1" fovy="45"/>
    <geom name="floor" type="plane" pos="0 0 0" size="6 6 0.1"
          rgba="0.85 0.85 0.85 1" condim="3"/>

    <!-- 挡板：slide joint 沿 x 轴，配 velocity 执行器（动作=目标速度） -->
    <body name="paddle" pos="0 0 0.06">
      <joint name="paddle_slide" type="slide" axis="1 0 0"
             range="-1.0 1.0" damping="0.5"/>
      <geom name="paddle_geom" type="box" size="0.15 0.35 0.06" mass="1.0"
            rgba="0.2 0.55 0.9 1" condim="3"/>
    </body>

    <!-- 小球：自由刚体 -->
    <body name="ball" pos="0 0 1.5">
      <joint name="ball_free" type="free"/>
      <geom name="ball_geom" type="sphere" size="0.05" mass="0.05"
            rgba="0.9 0.3 0.2 1" condim="3"/>
    </body>
  </worldbody>

  <actuator>
    <!-- 速度执行器：ctrl 即目标速度（m/s），kv 为跟踪增益 -->
    <velocity name="paddle_vel" joint="paddle_slide" kv="50"
              ctrlrange="-6 6" forcerange="-100 100"/>
  </actuator>
</mujoco>
